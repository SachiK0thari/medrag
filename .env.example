# Copy to .env and fill in. Never commit .env.

# Required
OPENROUTER_API_KEY=sk-or-v1-your_key_here
PINECONE_API_KEY=pcsk_your_key_here

# Recommended (raises PubMed rate limit 3 -> 10 req/s)
NCBI_API_KEY=your_ncbi_key_here
NCBI_EMAIL=you@example.com

# Optional overrides
LLM_MODEL=deepseek/deepseek-v4.1-flash   # any OpenRouter model id
LLM_REASONING_ENABLED=false               # DeepSeek thinking mode (more tokens)
LLM_TIMEOUT_S=120                         # per-request timeout in seconds
RERANKER_BACKEND=local                    # "pinecone" = Pinecone's hosted copy of the same reranker (fast on small CPUs, monthly quota)
RATE_LIMIT_PER_CLIENT=10                  # questions per visitor per window (0 = off)
RATE_LIMIT_WINDOW_S=3600                  # the per-visitor window, in seconds
RATE_LIMIT_GLOBAL_PER_DAY=200             # questions from all visitors per 24 h (0 = off)
PINECONE_INDEX_NAME=medrag-glp1
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
INGEST_MAX_PAPERS=500

# Only for scripts/upload_corpus.py (publishing the corpus the Space builds from)
# HF_TOKEN=hf_your_write_token_here
